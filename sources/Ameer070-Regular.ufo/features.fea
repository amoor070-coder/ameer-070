# contextual tashkeel clearance (qa/ctxsolve.py)
@SOLVE_ANYMARK = [damma dammatan fatha fathatan kasra kasratan shadda shaddaDamma shaddaDammatan shaddaFatha shaddaFathatan shaddaKasra shaddaKasratan sukun superscriptAlef gravecomb acutecomb circumflexcomb tildecomb macroncomb brevecomb dotaccentcomb dieresiscomb ringcomb hungarumlautcomb caroncomb commaaccentcomb cedillacomb ogonekcomb uni0615 uni0653 uni0654 uni0655 uni0656 uni0657 uni0658 uni06DB];
lookup SOLVE_ADJ_m80_0 { pos @SOLVE_ANYMARK <-80 0 0 0>; } SOLVE_ADJ_m80_0;
