lookup KERN_ARAB {
    # KERN_ARAB RTL: pair values are written as <v 0 v 0> (XPlacement+XAdvance) so the kern acts between the pair itself in RTL (fea_work, v1.2)
    lookupflag IgnoreMarks;
    pos alef.fina dad.init <-24 0 -24 0>;
    pos alef.fina dad.isol <-24 0 -24 0>;
    pos alef.fina noon.isol <-16 0 -16 0>;
    pos alef.fina sheen.init <-30 0 -30 0>;
    pos alef.fina sheen.isol <-30 0 -30 0>;
    pos alef.isol dad.init <-24 0 -24 0>;
    pos alef.isol dad.isol <-24 0 -24 0>;
    pos alef.isol noon.isol <-16 0 -16 0>;
